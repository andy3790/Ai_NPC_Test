        {
          "sequence": 1,
          "actor": "윤",
          "speech": "저는 통밀빵으로 할게요.",
          "action": "탁자 위의 통밀빵을 집어 든다."
        },
        {
          "sequence": 2,
          "actor": "미루",
          "speech": "그럼 저는 잼빵 먹을게요.",
          "action": "탁자 위의 잼빵을 집어 든다."
        },
        {
          "sequence": 3,
          "actor": "상황",
          "speech": "창밖에서 잠깐 음악이 들린다. 옆 휴게실 사람이 “좀 더 크게 틀까요?” 하고 묻는다.",
          "action": ""
