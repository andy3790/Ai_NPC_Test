        {
          "sequence": 1,
          "actor": "한결",
          "speech": "앞줄은 목이 아플 것 같아서 저는 취소표 좀 기다려 볼래요.",
          "action": "매표소 옆으로 비켜서요."
        },
        {
          "sequence": 2,
          "actor": "은서",
          "speech": "저는 앞줄이라도 볼래요. 기다리다 시작 놓치기는 싫어요.",
          "action": "매표소 앞으로 가서 앞줄 한 자리 구매를 요청해요."
        },
        {
          "sequence": 3,
          "actor": "상황",
          "speech": "대기석에 물과 따뜻한 보리차를 둔 직원이 “기다리는 동안 뭐 드실래요?” 하고 묻는다.",
          "action": ""
        },
        {
          "sequence": 4,
          "actor": "한결",
          "speech": "따뜻한 보리차로 주세요. 고마워요.",
          "action": ""
        },
        {
          "sequence": 5,
          "actor": "은서",
          "speech": "저는 물로 주세요. 고마워요.",
          "action": ""
        },
        {
          "sequence": 6,
          "actor": "상황",
          "speech": "직원이 매표기로 돌아온다. “취소표는 아직 없네요. 아까 그 앞줄로 하실 분 계세요?”",
          "action": ""
        },
        {
          "sequence": 7,
          "actor": "한결",
          "speech": "저는 조금 더 기다릴게요. 앞줄은 보기 불편해서요.",
          "action": ""
        },
        {
          "sequence": 8,
          "actor": "은서",
          "speech": "네, 저는 앞줄 한 자리 주세요.",
          "action": "결제할 카드를 꺼내요."
        },
        {
          "sequence": 9,
          "actor": "한결",
          "speech": "",
          "action": ""
        },
        {
          "sequence": 10,
          "actor": "은서",
          "speech": "",
          "action": "직원에게 결제할 카드를 내밀어요."
