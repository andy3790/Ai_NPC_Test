        {
          "sequence": 1,
          "actor": "윤",
          "speech": "저는 통밀빵이 좋아요. 먼저 골라도 돼요?",
          "action": ""
        },
        {
          "sequence": 2,
          "actor": "미루",
          "speech": "그럼요. 저는 잼빵 먹을게요.",
          "action": "잼빵을 집어 자기 앞으로 가져온다."
        },
        {
          "sequence": 3,
          "actor": "상황",
          "speech": "창밖에서 잠깐 음악이 들린다. 옆 휴게실 사람이 “좀 더 크게 틀까요?” 하고 묻는다.",
          "action": ""
        },
        {
          "sequence": 4,
          "actor": "윤",
          "speech": "지금 정도가 좋아요. 더 크게는 안 틀어 주셔도 돼요.",
          "action": "통밀빵을 집어 자기 앞으로 가져온다."
        },
        {
          "sequence": 5,
          "actor": "미루",
          "speech": "저도 지금 정도가 좋아요.",
          "action": "잼빵을 한 입 베어 문다."
        },
        {
          "sequence": 6,
          "actor": "상황",
          "speech": "빵을 가져온 사람이 “아까 빵 얘기요. 다음에도 사 올까요?” 하고 묻는다. 여전히 쉬는 시간이다.",
          "action": ""
        },
        {
          "sequence": 7,
          "actor": "윤",
          "speech": "네, 다음에도 통밀빵이면 좋겠어요. 잘 먹을게요.",
          "action": "통밀빵을 한 입 베어 문다."
        },
        {
          "sequence": 8,
          "actor": "미루",
          "speech": "저는 다음에도 잼빵으로 부탁드려요. 잘 먹고 있어요.",
          "action": ""
        }
