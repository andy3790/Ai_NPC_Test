    {
      "id": "luna-v5",
      "kind": "conversation",
      "source": ".cache/harbor-live/2026-11-06T21-32-46-475Z",
      "model": "gpt-6-luna",
      "calls": 72,
      "estimatedUsd": 0.017424264999999998,
      "runs": [
        {
          "part": "profile1-run1",
          "runId": "1bc0f346-0d35-4d72-83bd-2c886cd22fe6",
          "profile": "harbor-profile/1",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 19,
          "speechCount": 10,
          "languageFlags": [
            {
              "speechIndex": 3,
              "speakerId": "miru",
              "speech": "한 통인 것은 확인했고, 연소 시간과 내일 날씨는 아직 모르는 일이네요. 오늘 밤の 사용을 우선하자는 제안에 동의하겠습니다.",
              "action": "작은 수첩에 오늘 밤 사용 우선이라고 적습니다."
            },
            {
              "speechIndex": 9,
              "speakerId": "yoon",
              "speech": "준비はできています。今、火をつけます。",
              "action": "등불에 불을 붙입니다."
            }
          ]
        },
        {
          "part": "profile1-run2",
          "runId": "b4111035-85f7-4d45-b98a-cc7fca8009c0",
          "profile": "harbor-profile/1",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 17,
          "speechCount": 9,
          "languageFlags": []
        },
        {
          "part": "profile2-run1",
          "runId": "bf31beea-a404-4720-a215-65dccb0756d6",
          "profile": "harbor-profile/2",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 17,
          "speechCount": 9,
          "languageFlags": [
            {
              "speechIndex": 4,
              "speakerId": "yoon",
              "speech": "오늘 밤 쓰는 쪽에 동의해요. 다만 밤通し持つとはまだ言えません。まず火をつけて、油の減り方を見ます。",
              "action": ""
            },
            {
              "speechIndex": 6,
              "speakerId": "yoon",
              "speech": "등불에 넣을 기름을 공급할게요. 양は目で確かめます。",
              "action": "등불에 기름을 조심히 공급한다."
            },
            {
              "speechIndex": 8,
              "speakerId": "yoon",
              "speech": "はい、火をつけます。",
              "action": "準備した灯に火をつける。"
            }
          ]
        },
        {
          "part": "profile2-run2",
          "runId": "b131ccbf-b7aa-4479-915a-c3494d9a6ce9",
          "profile": "harbor-profile/2",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 19,
          "speechCount": 10,
          "languageFlags": [
            {
              "speechIndex": 9,
              "speakerId": "yoon",
              "speech": "불을 붙일게요. 밤새 유지된다고는 아직 말え지 않아요.",
              "action": "준비된 등불に火をつける。"
            }
          ]
        }
      ]
    },
    {
      "id": "luna-v10",
      "kind": "conversation",
      "source": ".cache/harbor-live/2026-11-06T21-37-58-085Z",
      "model": "gpt-6-luna",
      "calls": 70,
      "estimatedUsd": 0.016530194999999998,
      "runs": [
        {
          "part": "profile1-run1",
          "runId": "3e8fcdb4-5ad8-4205-9c86-b543d7e24410",
          "profile": "harbor-profile/1",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 17,
          "speechCount": 9,
          "languageFlags": [
            {
              "speechIndex": 8,
              "speakerId": "yoon",
              "speech": "점화하겠습니다. 밤새 유지될지는 아직 장담할 수 없습니다.",
              "action": "등불に火をつけます。"
            },
            {
              "speechIndex": 9,
              "speakerId": "miru",
              "speech": "불が点いたことと、今夜の使用を優先する方針を記録します。燃焼時間と明日の天気は未確認のままにしておきます。",
              "action": "수첩에 방침과 등불이 현재 빛을 내는 사실을 적습니다."
            }
          ]
        },
        {
          "part": "profile1-run2",
          "runId": "dd32e378-9698-4588-9300-5dc2829f815c",
          "profile": "harbor-profile/1",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 19,
          "speechCount": 10,
          "languageFlags": [
            {
              "speechIndex": 8,
              "speakerId": "miru",
              "speech": "기름 공급이 끝났군요. 윤 씨, 준비된 등불に 불을つけていただけますか？",
              "action": ""
            }
          ]
        },
        {
          "part": "profile2-run1",
          "runId": "155e2b4f-b0bc-4d70-b94b-d6dea044a5dc",
          "profile": "harbor-profile/2",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 17,
          "speechCount": 9,
          "languageFlags": [
            {
              "speechIndex": 1,
              "speakerId": "yoon",
              "speech": "기름통을 먼저 확인할게요. 한 통 남았다는 건 알しています만, 지금 눈앞에서 상태を見ます。",
              "action": "기름통을 살펴본다."
            },
            {
              "speechIndex": 3,
              "speakerId": "yoon",
              "speech": "오늘 밤使う方針には同意します。ただ、どれだけ持つかは、火をつけて実際に見ないと約束できません。",
              "action": ""
            },
            {
              "speechIndex": 6,
              "speakerId": "yoon",
              "speech": "그럼 등불に油を入れます。こぼさないよう、口元を見ていてください。",
              "action": "등불에 기름을 공급한다."
            },
            {
              "speechIndex": 8,
              "speakerId": "yoon",
              "speech": "火をつけます。",
              "action": "準備した灯火に火をつける。"
            },
            {
              "speechIndex": 9,
              "speakerId": "miru",
              "speech": "오늘 밤 사용 방침에 세 사람이 동의했고, 등불에 불がついて今光っています。 연소 시간은 확인되지 않은 채로 적을게요.",
              "action": "수첩에 합의한 방침과 지금 등불이 빛나는 것을 기록한다."
            }
          ]
        },
        {
          "part": "profile2-run2",
          "runId": "aaba3431-70b3-4aff-8e6b-b257ea31d0d4",
          "profile": "harbor-profile/2",
          "status": "completed",
          "completionReason": "goals_achieved",
          "calls": 17,
          "speechCount": 9,
          "languageFlags": []
        }
      ]
