# Copy to .env and set the key locally. npm run start:openai loads .env.
OPENAI_API_KEY=

# Per-call limit includes reasoning and visible output. Not a spending cap.
OPENAI_MAX_OUTPUT_TOKENS=4096

# Optional additional model capability profiles; no keys in this JSON.
# NPC_OPENAI_MODELS=[{"id":"your-model-id","efforts":["low","medium"],"defaultEffort":"low","reasoning":true}]

# Optional history sources in addition to data/, reports/, .cache/.
# NPC_LAB_HISTORY_ROOTS=["D:/NPC/previous-data","D:/NPC/exports"]
# NPC_LAB_HISTORY_DATABASE=data/history/npc-history.sqlite
