{
  "name": "npc-dialogue-lab",
  "version": "1.4.0",
  "description": "Local Codex CLI and OpenAI API NPC dialogue experiments with character, world, token and latency evaluation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dialogue:eval": "node --env-file-if-exists=.env --import tsx scripts/dialogue-eval.ts",
    "world:eval": "node --env-file-if-exists=.env --import tsx scripts/world-eval.ts",
    "dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "start:openai": "node --env-file-if-exists=.env dist/cli.js serve --adapter openai --port 4318",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "models:check": "tsx scripts/check-models.ts",
    "test": "tsx --test tests/*.test.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "smoke:ui": "tsx scripts/ui-smoke.ts",
    "smoke:history": "tsx scripts/history-ui-smoke.ts",
    "smoke:editor": "tsx scripts/editor-ui-smoke.ts",
    "smoke:options": "tsx scripts/optional-settings-ui-smoke.ts",
    "smoke:models": "tsx scripts/model-pricing-ui-smoke.ts",
    "smoke:findings": "tsx scripts/finding-ui-smoke.ts",
    "smoke:management": "tsx scripts/run-management-ui-smoke.ts",
    "smoke:bulk-delete": "tsx scripts/bulk-delete-ui-smoke.ts",
    "smoke:openai": "node --env-file-if-exists=.env --import tsx scripts/openai-smoke.ts",
    "assets:build": "node assets/npc-canon/build.mjs",
    "seowol:build": "node assets/seowol/build.mjs",
    "seowol:live": "node --env-file-if-exists=.env --import tsx scripts/seowol-live.ts",
    "assets:validate": "tsx assets/npc-canon/validate.ts",
    "assets:smoke": "tsx assets/npc-canon/smoke.ts",
    "assets:gallery": "node assets/npc-canon/gallery-check.mjs",
    "check:publish": "tsx scripts/check-publish.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run assets:validate && npm run assets:smoke && npm run check:publish",
    "verify:ui": "npm run smoke:ui && npm run smoke:editor && npm run smoke:options && npm run smoke:models && npm run smoke:history && npm run smoke:findings && npm run smoke:management && npm run smoke:bulk-delete && npm run smoke:world && npm run smoke:spatial && npm run smoke:keys && npm run assets:gallery",
    "smoke:world": "tsx scripts/world-ui-smoke.ts",
    "smoke:spatial": "tsx scripts/spatial-ui-smoke.ts",
    "smoke:keys": "tsx scripts/api-key-ui-smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
