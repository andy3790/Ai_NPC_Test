{
  "name": "npc-dialogue-lab",
  "version": "1.1.0",
  "description": "Local Codex CLI NPC dialogue experiments with character, world, token and latency evaluation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "smoke:ui": "tsx scripts/ui-smoke.ts",
    "assets:build": "node assets/npc-canon/build.mjs",
    "assets:validate": "tsx assets/npc-canon/validate.ts",
    "assets:smoke": "tsx assets/npc-canon/smoke.ts",
    "assets:gallery": "node assets/npc-canon/gallery-check.mjs",
    "check:publish": "tsx scripts/check-publish.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run assets:validate && npm run assets:smoke && npm run check:publish"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
